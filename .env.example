MONGODB_URI=mongodb://127.0.0.1:27017/yap

# Cloudflare Realtime TURN key (dash.cloudflare.com -> Realtime -> TURN Keys).
# Leave unset for STUN-only.
CLOUDFLARE_TURN_KEY_ID=your-turn-key-id
CLOUDFLARE_TURN_API_TOKEN=your-turn-api-token

# Clerk keys (dashboard.clerk.com -> API keys). Secret key stays server-side only.
CLERK_PUBLISHABLE_KEY=pk_test_your-key
CLERK_SECRET_KEY=sk_test_your-key
